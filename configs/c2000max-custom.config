# Overlay for configs/c2000max.config: append it after the full config,
# then run "make defconfig". Later lines override earlier ones.

# Official APP compatibility service (vendor cloud MQTT bridge)
# CONFIG_PACKAGE_luci-app-c2000max-app is not set
# CONFIG_PACKAGE_c2000max-app is not set
# CONFIG_PACKAGE_mosquitto-nossl is not set
# CONFIG_PACKAGE_mosquitto-client-nossl is not set
# CONFIG_PACKAGE_libmosquitto-nossl is not set

# OpenClash
# CONFIG_PACKAGE_luci-app-openclash is not set

# Leigod accelerator
# CONFIG_PACKAGE_luci-i18n-leigod-acc-zh-cn is not set
# CONFIG_PACKAGE_luci-app-leigod-acc is not set
# CONFIG_PACKAGE_leigod-acc is not set

# UU game booster
# CONFIG_PACKAGE_luci-app-uugamebooster is not set

# NetBird client and its LuCI app
CONFIG_PACKAGE_netbird=y
CONFIG_PACKAGE_luci-app-netbird=y
CONFIG_PACKAGE_luci-i18n-netbird-zh-cn=y

# LuCI switch and log viewer for daed (pulls in daed-geoip/daed-geosite)
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# Weekly geoip/geosite update for daed and passwall2
CONFIG_PACKAGE_c2000max-geo-update=y
